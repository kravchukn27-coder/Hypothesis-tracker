// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HypothesisStatus {
  NEW
  PLANNED
  IN_PROGRESS
  ACCEPTED
  HOLD
  DONE
}

enum ConversionMetric {
  CR
  LTV
  CR_LTV
}

enum ExperimentStage {
  DISCOVERY
  DESIGN
  DEVELOPMENT
  EXPERIMENTATION
  ANALYSIS
  DONE
}

model FunnelLevel {
  id          String       @id @default(cuid())
  name        String       @unique
  isCustom    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  hypotheses  Hypothesis[]
  experiments Experiment[]
}

model Product {
  id          String       @id @default(cuid())
  name        String       @unique
  isCustom    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  experiments Experiment[]
}

model Segment {
  id          String       @id @default(cuid())
  name        String       @unique
  isCustom    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  experiments Experiment[]
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String?
  sessionVersion      Int                  @default(0)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  invitedBy           User?                @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById         String?
  invitedUsers        User[]               @relation("Invites")
  passwordSetupTokens PasswordSetupToken[] @relation("PasswordSetupTokens")
  issuedTokens        PasswordSetupToken[] @relation("IssuedBy")
  hypothesisComments HypothesisComment[]
}

model PasswordSetupToken {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String
  issuedByUserId String
  user           User      @relation("PasswordSetupTokens", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy       User      @relation("IssuedBy", fields: [issuedByUserId], references: [id])
  expiresAt      DateTime
  usedAt         DateTime?
  invalidatedAt  DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, usedAt, invalidatedAt])
}

model LoginRateLimitBucket {
  id            String    @id @default(cuid())
  scope         String
  scopeKey      String
  failuresAt    Json      @default("[]")
  cooldownUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([scope, scopeKey])
}

model AuditLog {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model ErrorEvent {
  id            String   @id @default(cuid())
  signature     String   @unique
  errorName     String?
  errorMessage  String?
  route         String
  event         String
  count         Int      @default(1)
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  lastAlertedAt DateTime?
  lastUserId    String?
  lastMetadata  Json?

  @@index([lastSeenAt])
  @@index([lastUserId, lastSeenAt])
  @@index([route])
}

model Hypothesis {
  id            String            @id @default(cuid())
  name          String
  text          String
  funnelLevel   FunnelLevel?      @relation(fields: [funnelLevelId], references: [id])
  funnelLevelId String?
  conversion    ConversionMetric  @default(CR)
  impact        Int
  effort        Int
  reach         Float
  confidence    Float
  status        HypothesisStatus  @default(NEW)
  result        String?
  modeling      String?
  sampleSize    String?
  taskUrl       String?
  experiments   Experiment[]
  comments      HypothesisComment[]
  archived      Boolean           @default(false)
  archivedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([archived, status])
  @@index([funnelLevelId, archived])
}

model HypothesisComment {
  id           String     @id @default(cuid())
  hypothesisId String
  authorUserId String
  message      String
  createdAt    DateTime   @default(now())
  hypothesis   Hypothesis @relation(fields: [hypothesisId], references: [id], onDelete: Cascade)
  authorUser   User       @relation(fields: [authorUserId], references: [id])

  @@index([hypothesisId, createdAt])
}

model Experiment {
  id           String                 @id @default(cuid())
  name         String
  author       String?
  rollout      String?
  // startDate/endDate/stage are derived caches (PROD-019, 2026-08-07):
  // once weekStages exist, they're recomputed automatically from the
  // week entries (min/max weekStart, latest week's stage) — not
  // directly editable anymore. Kept as real columns (not computed on
  // every read) so existing queries/filters/sorts across the app keep
  // working unchanged.
  startDate    DateTime?
  endDate      DateTime?
  stage        ExperimentStage?
  weekStages   ExperimentWeekStage[]
  hypothesis   Hypothesis             @relation(fields: [hypothesisId], references: [id])
  hypothesisId String
  funnelLevels FunnelLevel[]
  products     Product[]
  segments     Segment[]
  archived     Boolean                @default(false)
  archivedAt           DateTime?
  // PROD-023: when a week's stage transitions to Done, the user is
  // asked whether to hide the experiment from the Calendar. Tri-state,
  // not a plain boolean: null = not asked yet (stays visible, so the
  // row — and the prompt itself — doesn't vanish out from under the
  // user before they answer, since Next.js auto-refreshes the calling
  // route as soon as the triggering Server Action resolves). true =
  // "Да" (hidden). false = "Нет" (explicitly kept visible). Existing
  // Done experiments that predate this prompt were backfilled to
  // `true`, preserving PROD-018's old unconditional auto-hide for
  // them specifically — everything else (not yet Done, or newly
  // created) starts at null.
  calendarHiddenOnDone Boolean?
  // PROD-036: Calendar-only row priority. Null means the experiment has
  // never been manually ordered and therefore follows the date fallback.
  manualOrder  Int?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([hypothesisId])
  @@index([archived, startDate])
}

/**
 * One experiment's stage for one specific week (PROD-019, 2026-08-07).
 * `weekStart` is always a Monday 00:00 local. Source of truth for
 * per-week progress on the Calendar; Experiment.stage/startDate/endDate
 * are a denormalized cache derived from these rows.
 */
model ExperimentWeekStage {
  id           String          @id @default(cuid())
  experiment   Experiment      @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  experimentId String
  weekStart    DateTime
  stage        ExperimentStage
  // PROD-025: completes this specific weekly stage without changing
  // the experiment's overall derived stage.
  completed    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([experimentId, weekStart])
}
