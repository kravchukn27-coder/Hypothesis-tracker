// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HypothesisStatus {
  NEW
  PLANNED
  IN_PROGRESS
  ACCEPTED
  HOLD
  DONE
}

enum ConversionMetric {
  CR
  LTV
  CR_LTV
}

enum ExperimentStage {
  DISCOVERY
  DESIGN
  DEVELOPMENT
  EXPERIMENTATION
  ANALYSIS
  DONE
}

model FunnelLevel {
  id          String       @id @default(cuid())
  name        String       @unique
  isCustom    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  hypotheses  Hypothesis[]
  experiments Experiment[]
}

model Platform {
  id          String       @id @default(cuid())
  name        String       @unique
  isCustom    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  experiments Experiment[]
}

model Channel {
  id          String       @id @default(cuid())
  name        String       @unique
  isCustom    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  experiments Experiment[]
}

model Market {
  id          String       @id @default(cuid())
  name        String       @unique
  isCustom    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  experiments Experiment[]
}

model Product {
  id          String       @id @default(cuid())
  name        String       @unique
  isCustom    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  experiments Experiment[]
}

model Segment {
  id          String       @id @default(cuid())
  name        String       @unique
  isCustom    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  experiments Experiment[]
}

model Hypothesis {
  id            String            @id @default(cuid())
  name          String
  text          String
  funnelLevel   FunnelLevel?      @relation(fields: [funnelLevelId], references: [id])
  funnelLevelId String?
  conversion    ConversionMetric  @default(CR)
  impact        Int
  effort        Int
  reach         Float
  confidence    Float
  status        HypothesisStatus  @default(NEW)
  result        String?
  comment       String?
  modeling      String?
  sampleSize    String?
  taskUrl       String?
  experiments   Experiment[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Experiment {
  id           String                 @id @default(cuid())
  name         String
  author       String?
  // startDate/endDate/stage are derived caches (PROD-019, 2026-08-07):
  // once weekStages exist, they're recomputed automatically from the
  // week entries (min/max weekStart, latest week's stage) — not
  // directly editable anymore. Kept as real columns (not computed on
  // every read) so existing queries/filters/sorts across the app keep
  // working unchanged.
  startDate    DateTime?
  endDate      DateTime?
  stage        ExperimentStage        @default(DISCOVERY)
  weekStages   ExperimentWeekStage[]
  hypothesis   Hypothesis             @relation(fields: [hypothesisId], references: [id])
  hypothesisId String
  funnelLevels FunnelLevel[]
  platforms    Platform[]
  channels     Channel[]
  markets      Market[]
  products     Product[]
  segments     Segment[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

/**
 * One experiment's stage for one specific week (PROD-019, 2026-08-07).
 * `weekStart` is always a Monday 00:00 local. Source of truth for
 * per-week progress on the Calendar; Experiment.stage/startDate/endDate
 * are a denormalized cache derived from these rows.
 */
model ExperimentWeekStage {
  id           String          @id @default(cuid())
  experiment   Experiment      @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  experimentId String
  weekStart    DateTime
  stage        ExperimentStage
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([experimentId, weekStart])
}
